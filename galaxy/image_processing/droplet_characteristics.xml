<tool id="im_proc_droplet_characteristics" name="Droplet characteristics" version="0.1.0">
  <description>Gets droplet characteristics</description>
  <requirements>
    <requirement type="package" version="2.22.0">imageio</requirement>
  </requirements>
  <command>python '$__tool_directory__/droplet_characteristics.py' '$input' '$x' '$y' '$width' '$height' '$threshold' '$output_value' '$output_image'</command>
  <inputs>
    <param format="jpg" name="input" type="data" label="Source file"/>
    <param name="x" type="integer" value="464" label="Top left X value"/>
    <param name="y" type="integer" value="193" label="Top left Y value"/>
    <param name="width" type="integer" value="169" label="Width value"/>
    <param name="height" type="integer" value="154" label="Height value"/>
    <param name="threshold" type="integer" value="50" label="Threshold value"/>
  </inputs>
  <outputs>
    <data format="int" name="output_value" />
    <data format="jpg" name="output_image" />
  </outputs>


  <help>
    This tool gets characteristics of the droplet by image
  </help>

</tool>